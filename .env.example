# Copy to .env.local (development) or set these in your host's environment (production).
# NEVER commit real values. Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- Required -------------------------------------------------------------
AUTH_SECRET=                      # long random string; signs login sessions
APP_URL=https://your-domain.com   # public address: email links, payment callbacks, sitemap, canonical URLs
NEXTAUTH_URL=https://your-domain.com
DATABASE_PATH=/var/data/banglaenglish.db   # keep on a persistent, backed-up disk

# ---- Sign in with Google (optional; the button appears only when both are set) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI:  https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Demo ----------------------------------------------------------------------
# SHOW_DEMO_LOGINS=true          # only for a public demo site: shows the demo passwords on the login page

# ---- Behind a reverse proxy (nginx, Caddy, a host's load balancer) ----------
TRUST_PROXY=true                  # read the visitor's real IP for rate limits (only set when a proxy really sits in front)

# ---- Public contact details (shown on /contact; leave blank to hide) -------
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_ADDRESS=Mymensingh, Bangladesh

# ---- Email (leave SMTP_HOST empty to store emails in Admin > Email outbox instead) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BanglaEnglish <no-reply@your-domain.com>"

# ---- Uploads ------------------------------------------------------------------
UPLOAD_DIR=/var/data/uploads      # persistent disk; served only through /api/files with access checks

# ---- Payments -----------------------------------------------------------------
# Manual bKash/Nagad/Rocket/bank payments need no keys (set the accounts in Admin > Payment accounts).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true           # set to false only after a successful sandbox payment
PAYMENT_WEBHOOK_SECRET=           # 16+ characters; for signed callbacks from a payment bridge

# ---- Live classes ---------------------------------------------------------------
CRON_SECRET=                      # 16+ characters; protects the reminder endpoint (see DEPLOYMENT.md)
JITSI_BASE_URL=https://meet.jit.si   # or your own Jitsi server

# ---- AI (optional; without a key AI features show "unavailable") -----------------
AI_PROVIDER=gemini                # gemini | groq | openrouter | ollama | custom | anthropic
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=
